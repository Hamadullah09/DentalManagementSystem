@page "/patients/{PatientId:guid}"
@page "/patients/{PatientId:guid}/{Tab}"
@attribute [Authorize(Policy = Permissions.PatientsView)]
@inject PatientService Patients
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IPermissionGuard Guard

<PageTitle>@(_summary?.Patient.Name.Display ?? "Patient") - Meridian Dental Surgery</PageTitle>

@if (_loading)
{
    <div class="loading-bar mb-3"></div>
    <div class="skeleton mb-3" style="height:120px;"></div>
    <div class="skeleton" style="height:340px;"></div>
}
else if (_summary is null)
{
    <div class="card-ds">
        <EmptyState IconName="alert-circle" Title="Patient not found"
                    Message="This record may have been merged or archived.">
            <a href="/patients" class="btn btn-sm btn-primary">Back to the patient list</a>
        </EmptyState>
    </div>
}
else
{
    <PatientBanner Patient="_summary.Patient" Risk="_summary.Risk" Alerts="_summary.ActiveAlerts">
        <Actions>
            <a href="/patients/@PatientId/edit" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                <Icon Name="edit" Size="13" /> Edit
            </a>
            <a href="/schedule?patient=@PatientId" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                <Icon Name="calendar" Size="13" /> Book
            </a>
            <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="Print">
                <Icon Name="printer" Size="13" /> Print
            </button>
        </Actions>
    </PatientBanner>

    @if (_summary.MedicalHistoryOutOfDate)
    {
        <div class="alert-ds a-warning mb-3">
            <Icon Name="alert-circle" Size="16" />
            <div class="flex-grow-1">
                <strong>The medical history needs updating.</strong>
                @if (_summary.LatestMedicalReview is null)
                {
                    <span> No review has ever been recorded for this patient.</span>
                }
                else
                {
                    <span> Last reviewed on @Ui.Date(_summary.LatestMedicalReview.ReviewDate).</span>
                }
            </div>
            <button class="btn btn-sm btn-outline-secondary no-print" @onclick="@(() => Go("medical"))">Review now</button>
        </div>
    }

    <div class="tabs-ds no-print" role="tablist" aria-label="Patient record sections">
        @foreach (var tab in VisibleTabs)
        {
            <button class="tab-ds @(CurrentTab == tab.Key ? "active" : "")" role="tab"
                    aria-selected="@(CurrentTab == tab.Key ? "true" : "false")"
                    @onclick="() => Go(tab.Key)">
                @tab.Label
                @if (tab.Count(_summary) is { } count and > 0)
                {
                    <span class="count">@count</span>
                }
            </button>
        }
    </div>

    @if (!CanOpen(CurrentTab))
    {
        @*
            Reached by typing the URL, following a stale link or using the back
            button after a permission change. The tab strip would not have
            offered it, but the strip is not the control — this is.
        *@
        <div class="card-ds">
            <EmptyState IconName="shield" Title="You cannot open this section"
                        Message="Your role does not include access to this part of the patient record. The rest of the record is still available to you.">
                <button class="btn btn-sm btn-primary" @@onclick="@(() => Go("overview"))">Back to the overview</button>
            </EmptyState>
        </div>
    }
    else
    {
    @switch (CurrentTab)
    {
        case "overview":
            <PatientOverviewTab Summary="_summary" />
            break;
        case "medical":
            <PatientMedicalTab PatientId="PatientId" OnChanged="ReloadAsync" />
            break;
        case "chart":
            <PatientChartTab PatientId="PatientId" />
            break;
        case "perio":
            <PatientPerioTab PatientId="PatientId" />
            break;
        case "plans":
            <PatientPlansTab PatientId="PatientId" OnChanged="ReloadAsync" />
            break;
        case "appointments":
            <PatientAppointmentsTab PatientId="PatientId" />
            break;
        case "treatment":
            <PatientTreatmentTab PatientId="PatientId" />
            break;
        case "notes":
            <PatientNotesTab PatientId="PatientId" />
            break;
        case "prescriptions":
            <PatientPrescriptionsTab PatientId="PatientId" />
            break;
        case "documents":
            <PatientDocumentsTab PatientId="PatientId" />
            break;
        case "account":
            <PatientAccountTab PatientId="PatientId" OnChanged="ReloadAsync" />
            break;
        case "insurance":
            <PatientInsuranceTab PatientId="PatientId" />
            break;
        case "communications":
            <PatientCommunicationsTab PatientId="PatientId" />
            break;
        default:
            <PatientOverviewTab Summary="_summary" />
            break;
    }
    }
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    [Parameter] public string? Tab { get; set; }

    private PatientSummary? _summary;
    private bool _loading = true;
    private Guid _loadedFor;

    private string CurrentTab => string.IsNullOrWhiteSpace(Tab) ? "overview" : Tab.ToLowerInvariant();

    private record TabDefinition(string Key, string Label, string Permission, Func<PatientSummary, int?> Count);

    /// <summary>
    /// Every section of the record, with the permission that opens it.
    /// <para>
    /// The separation the practice actually needs lives in this table: reception
    /// can reach a patient and still not open the clinical notes, the medical
    /// history or the periodontal record, because none of those are covered by
    /// Patients.View.
    /// </para>
    /// </summary>
    private static readonly TabDefinition[] Tabs =
    {
        new("overview", "Overview", Permissions.PatientsView, _ => null),
        new("medical", "Medical history", Permissions.MedicalHistoryView, _ => null),
        new("chart", "Dental chart", Permissions.DentalChartView, _ => null),
        new("perio", "Periodontal", Permissions.PeriodontalView, _ => null),
        new("plans", "Treatment plans", Permissions.TreatmentPlansView, s => s.OpenTreatmentItems == 0 ? null : s.OpenTreatmentItems),
        new("appointments", "Appointments", Permissions.AppointmentsView, _ => null),
        new("treatment", "Procedures", Permissions.ProceduresView, s => s.ProcedureCount == 0 ? null : s.ProcedureCount),
        new("notes", "Clinical notes", Permissions.ClinicalRecordsView, _ => null),
        new("prescriptions", "Prescriptions", Permissions.PrescriptionsView, _ => null),
        new("documents", "Documents", Permissions.DocumentsView, s => s.DocumentCount + s.RadiographCount == 0 ? null : s.DocumentCount + s.RadiographCount),
        new("account", "Account", Permissions.BillingView, _ => null),
        new("insurance", "Insurance", Permissions.InsuranceView, _ => null),
        new("communications", "Communications", Permissions.CommunicationsView, _ => null)
    };

    private IReadOnlySet<string> _permissions = new HashSet<string>();

    private IEnumerable<TabDefinition> VisibleTabs =>
        Tabs.Where(t => _permissions.Contains(t.Permission));

    private bool CanOpen(string tabKey)
    {
        var tab = Tabs.FirstOrDefault(t => t.Key == tabKey);

        // An unrecognised key falls through to the overview, which every user
        // holding Patients.View may see.
        return tab is null || _permissions.Contains(tab.Permission);
    }

    protected override async Task OnInitializedAsync() =>
        _permissions = await Guard.CurrentAsync();

    protected override async Task OnParametersSetAsync()
    {
        // Switching tabs re-runs parameters; only reload when the patient changes.
        if (_loadedFor == PatientId && _summary is not null) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _summary = await Patients.GetSummaryAsync(PatientId);
        _loadedFor = PatientId;
        _loading = false;
    }

    private void Go(string tab) =>
        Navigation.NavigateTo($"/patients/{PatientId}/{tab}", replace: true);

    private async Task Print()
    {
        try { await JS.InvokeVoidAsync("dentalApp.print"); }
        catch (JSException) { /* printing unavailable in this browser context */ }
    }
}
