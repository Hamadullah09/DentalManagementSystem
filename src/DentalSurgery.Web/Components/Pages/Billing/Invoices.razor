@page "/billing/invoices"
@attribute [Authorize(Policy = Permissions.BillingView)]
@inject IDbContextFactory<DentalDbContext> DbFactory
@inject BillingService Billing
@inject IDateTimeProvider Clock
@inject IJSRuntime JS

<PageTitle>Invoices - Meridian Dental Surgery</PageTitle>

<PageHeader Title="Invoices" Subtitle="All invoices raised in the selected period.">
    <Actions>
        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="ExportCsv">
            <Icon Name="download" Size="13" /> Export
        </button>
    </Actions>
</PageHeader>

<DateRangePicker From="_from" To="_to" OnChanged="OnRangeChanged" />

<div class="stat-grid mb-3">
    <StatTile Label="Invoices" Value="@_invoices.Count.ToString()" Accent="primary" Icon="receipt" />
    <StatTile Label="Invoiced" Value="@Ui.MoneyCompact(_invoices.Sum(i => i.Total))" Accent="accent" />
    <StatTile Label="Collected" Value="@Ui.MoneyCompact(_invoices.Sum(i => i.AmountPaid))" Accent="success" />
    <StatTile Label="Outstanding" Value="@Ui.MoneyCompact(_invoices.Sum(i => i.Balance))"
              Accent="@(_invoices.Sum(i => i.Balance) > 0 ? "warning" : "success")" />
    <StatTile Label="Overdue" Value="@_invoices.Count(i => i.IsOverdue).ToString()"
              Accent="@(_invoices.Any(i => i.IsOverdue) ? "danger" : "success")"
              Caption="@Ui.MoneyCompact(_invoices.Where(i => i.IsOverdue).Sum(i => i.Balance))" />
    <StatTile Label="Collection rate" Value="@($"{CollectionRate:0.#}%")"
              Accent="@(CollectionRate >= 90 ? "success" : CollectionRate >= 75 ? "warning" : "danger")" />
</div>

<div class="filter-bar">
    <div class="field grow">
        <label class="form-label">Search</label>
        <input class="form-control form-control-sm" placeholder="Invoice number or patient"
               @bind="_search" @bind:event="oninput" />
    </div>
    <div class="field">
        <label class="form-label">Status</label>
        <select class="form-select form-select-sm" @bind="_statusFilter">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<InvoiceStatus>())
            {
                <option value="@status">@Ui.Humanise(status)</option>
            }
        </select>
    </div>
    <div class="field" style="min-width:auto;">
        <label class="form-label">Show</label>
        <button class="btn btn-sm @(_unpaidOnly ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => _unpaidOnly = !_unpaidOnly">
            With a balance
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert-ds @(_isError ? "a-danger" : "a-success") mb-3">
        <Icon Name="@(_isError ? "alert-circle" : "check-circle")" Size="15" /><div>@_message</div>
    </div>
}

@if (Filtered.Count == 0)
{
    <div class="card-ds">
        <EmptyState IconName="receipt" Title="No invoices"
                    Message="Nothing matches the current period and filters." />
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-ds">
            <thead>
                <tr>
                    <th>Number</th>
                    <th class="nowrap">Issued</th>
                    <th class="nowrap">Due</th>
                    <th>Patient</th>
                    <th>Provider</th>
                    <th class="num">Total</th>
                    <th class="num">Paid</th>
                    <th class="num">Balance</th>
                    <th style="width:110px;">Status</th>
                    <th style="width:120px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Filtered)
                {
                    <tr>
                        <td class="mono">@invoice.InvoiceNumber</td>
                        <td class="nowrap">@Ui.DateShort(invoice.IssueDate)</td>
                        <td class="nowrap @(invoice.IsOverdue ? "text-danger fw-semibold" : "")">
                            @Ui.DateShort(invoice.DueDate)
                            @if (invoice.IsOverdue)
                            {
                                <div style="font-size:.7rem;">@invoice.DaysOverdue days over</div>
                            }
                        </td>
                        <td>
                            <a href="/patients/@invoice.PatientId/account" style="font-weight:600;">
                                @(invoice.Patient?.Name.Display ?? "Unknown")
                            </a>
                            <div class="text-faint" style="font-size:.72rem;">@invoice.Patient?.PatientNumber</div>
                        </td>
                        <td class="nowrap">@(invoice.Provider?.Name.Display ?? "-")</td>
                        <td class="num mono">@Ui.Money(invoice.Total)</td>
                        <td class="num mono text-muted">@Ui.Money(invoice.AmountPaid)</td>
                        <td class="num mono @(invoice.Balance > 0 ? "text-danger fw-semibold" : "")">
                            @Ui.Money(invoice.Balance)
                        </td>
                        <td><span class="badge-ds @Ui.BadgeFor(invoice.Status)">@Ui.Humanise(invoice.Status)</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                @if (invoice.Status == InvoiceStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => Issue(invoice.Id)">Issue</button>
                                }
                                else if (invoice.Balance > 0)
                                {
                                    <a href="/patients/@invoice.PatientId/account" class="btn btn-sm btn-outline-secondary">
                                        Payment
                                    </a>
                                }
                                <a class="btn btn-sm btn-outline-secondary" title="Download as a PDF"
                                   href="/api/exports/documents/invoice/@invoice.Id" target="_blank" rel="noopener">
                                    <Icon Name="printer" Size="12" />
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DateOnly _from;
    private DateOnly _to;
    private List<Invoice> _invoices = new();
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private bool _unpaidOnly;
    private string? _message;
    private bool _isError;

    private decimal CollectionRate
    {
        get
        {
            var total = _invoices.Where(i => i.Status != InvoiceStatus.Void).Sum(i => i.Total);
            return total == 0 ? 0 : Math.Round(100m * _invoices.Sum(i => i.AmountPaid) / total, 1);
        }
    }

    private List<Invoice> Filtered
    {
        get
        {
            var query = _invoices.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var text = _search.Trim();
                query = query.Where(i =>
                    i.InvoiceNumber.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                    (i.Patient?.Name.Display.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.Patient?.PatientNumber.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrEmpty(_statusFilter) && Enum.TryParse<InvoiceStatus>(_statusFilter, out var status))
                query = query.Where(i => i.Status == status);

            if (_unpaidOnly) query = query.Where(i => i.Balance > 0.005m);

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _to = Clock.Today;
        _from = _to.AddMonths(-3);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _invoices = await db.Invoices.AsNoTracking()
            .Include(i => i.Patient)
            .Include(i => i.Provider)
            .Where(i => i.IssueDate >= _from && i.IssueDate <= _to)
            .OrderByDescending(i => i.IssueDate).ThenByDescending(i => i.InvoiceNumber)
            .Take(1000)
            .ToListAsync();
    }

    private async Task OnRangeChanged((DateOnly From, DateOnly To) range)
    {
        _from = range.From;
        _to = range.To;
        await LoadAsync();
    }

    private async Task Issue(Guid invoiceId)
    {
        var result = await Billing.IssueInvoiceAsync(invoiceId);
        _message = result.Succeeded ? $"Invoice {result.Value!.InvoiceNumber} issued." : result.ErrorMessage;
        _isError = result.Failed;
        await LoadAsync();
    }

    private async Task ExportCsv()
    {
        var csv = CsvExport.Build(Filtered,
            ("Invoice", i => i.InvoiceNumber),
            ("Issued", i => CsvExport.Date(i.IssueDate)),
            ("Due", i => CsvExport.Date(i.DueDate)),
            ("Patient number", i => i.Patient?.PatientNumber ?? ""),
            ("Patient", i => i.Patient?.Name.Display ?? ""),
            ("Provider", i => i.Provider?.DisplayName ?? ""),
            ("Total", i => CsvExport.Money(i.Total)),
            ("Paid", i => CsvExport.Money(i.AmountPaid)),
            ("Balance", i => CsvExport.Money(i.Balance)),
            ("Status", i => i.Status.ToString()));

        await CsvExport.DownloadAsync(JS, "invoices.csv", csv);
    }
}
