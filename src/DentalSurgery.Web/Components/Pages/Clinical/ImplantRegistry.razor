@page "/implants"
@attribute [Authorize(Policy = Permissions.ImplantsView)]
@inject IDbContextFactory<DentalDbContext> DbFactory
@inject IDateTimeProvider Clock
@inject IJSRuntime JS

<PageTitle>Implant registry - Meridian Dental Surgery</PageTitle>

<PageHeader Title="Implant registry"
            Subtitle="Every fixture placed, traceable by lot number for recall and warranty.">
    <Actions>
        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="ExportCsv">
            <Icon Name="download" Size="13" /> Export
        </button>
    </Actions>
</PageHeader>

<div class="stat-grid mb-3">
    <StatTile Label="Implants placed" Value="@_implants.Count.ToString()" Accent="primary" Icon="activity" />
    <StatTile Label="Restored" Value="@_implants.Count(i => i.Status == ImplantStatus.Restored).ToString()"
              Accent="success" Icon="check-circle" />
    <StatTile Label="Integrating" Value="@_implants.Count(i => i.Status is ImplantStatus.Placed or ImplantStatus.Integrating).ToString()"
              Accent="info" />
    <StatTile Label="Failed" Value="@FailedCount.ToString()"
              Accent="@(FailedCount > 0 ? "danger" : "success")"
              Caption="@($"{FailureRate:0.##}% failure rate")" />
    <StatTile Label="Mean insertion torque" Value="@($"{MeanTorque:0} Ncm")" Accent="purple" />
    <StatTile Label="Review due" Value="@_implants.Count(i => i.NextReviewDue <= Clock.Today).ToString()"
              Accent="warning" Icon="bell" />
</div>

<div class="filter-bar">
    <div class="field grow">
        <label class="form-label">Search</label>
        <input class="form-control form-control-sm" placeholder="Patient, lot number, manufacturer or system"
               @bind="_search" @bind:event="oninput" />
    </div>
    <div class="field">
        <label class="form-label">Status</label>
        <select class="form-select form-select-sm" @bind="_statusFilter">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<ImplantStatus>())
            {
                <option value="@status">@Ui.Humanise(status)</option>
            }
        </select>
    </div>
</div>

@if (Filtered.Count == 0)
{
    <div class="card-ds">
        <EmptyState IconName="activity" Title="No implants recorded"
                    Message="Fixtures appear here as soon as a placement procedure is completed." />
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-ds">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th style="width:56px;">Tooth</th>
                    <th>System</th>
                    <th class="nowrap">Size</th>
                    <th>Lot</th>
                    <th class="nowrap">Placed</th>
                    <th>Surgeon</th>
                    <th class="nowrap">Torque / ISQ</th>
                    <th class="nowrap">Bone</th>
                    <th class="nowrap">Restored</th>
                    <th class="nowrap">Review</th>
                    <th style="width:110px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var implant in Filtered)
                {
                    <tr>
                        <td>
                            <a href="/patients/@implant.PatientId/treatment" style="font-weight:600;">
                                @(implant.Patient?.Name.Display ?? "Unknown")
                            </a>
                        </td>
                        <td class="mono">@implant.Tooth?.FdiNumber</td>
                        <td>
                            <div>@implant.SystemName</div>
                            <div class="text-faint" style="font-size:.72rem;">@implant.Manufacturer</div>
                        </td>
                        <td class="mono nowrap">@implant.DiameterMm&times;@implant.LengthMm</td>
                        <td class="mono" style="font-size:.75rem;">@implant.LotNumber</td>
                        <td class="nowrap">@Ui.DateShort(implant.PlacementDate)</td>
                        <td class="nowrap">@(implant.SurgeonStaff?.Name.Display ?? "-")</td>
                        <td class="mono nowrap">
                            @(implant.InsertionTorqueNcm?.ToString() ?? "-") / @(implant.StabilityQuotientIsq?.ToString() ?? "-")
                        </td>
                        <td>@(implant.BoneQuality == BoneQuality.Unknown ? "-" : implant.BoneQuality.ToString())</td>
                        <td class="nowrap">@Ui.DateShort(implant.RestorationDate)</td>
                        <td class="nowrap @(implant.NextReviewDue <= Clock.Today ? "text-warning fw-semibold" : "")">
                            @Ui.DateShort(implant.NextReviewDue)
                        </td>
                        <td><span class="badge-ds @Ui.BadgeFor(implant.Status)">@Ui.Humanise(implant.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DentalImplant> _implants = new();
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;

    private int FailedCount => _implants.Count(i => i.Status is ImplantStatus.Failed or ImplantStatus.Explanted);
    private decimal FailureRate => _implants.Count == 0 ? 0 : Math.Round(100m * FailedCount / _implants.Count, 2);

    private double MeanTorque
    {
        get
        {
            var values = _implants.Where(i => i.InsertionTorqueNcm.HasValue)
                                  .Select(i => i.InsertionTorqueNcm!.Value).ToList();
            return values.Count == 0 ? 0 : values.Average();
        }
    }

    private List<DentalImplant> Filtered
    {
        get
        {
            var query = _implants.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var text = _search.Trim();
                query = query.Where(i =>
                    (i.Patient?.Name.Display.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.LotNumber?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    i.Manufacturer.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                    i.SystemName.Contains(text, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(_statusFilter) && Enum.TryParse<ImplantStatus>(_statusFilter, out var status))
                query = query.Where(i => i.Status == status);

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _implants = await db.DentalImplants.AsNoTracking()
            .Include(i => i.Patient)
            .Include(i => i.Tooth)
            .Include(i => i.SurgeonStaff)
            .OrderByDescending(i => i.PlacementDate)
            .ToListAsync();
    }

    private async Task ExportCsv()
    {
        var csv = CsvExport.Build(Filtered,
            ("Patient", i => i.Patient?.Name.Display ?? ""),
            ("Tooth", i => i.Tooth?.FdiNumber.ToString() ?? ""),
            ("Manufacturer", i => i.Manufacturer),
            ("System", i => i.SystemName),
            ("Reference", i => i.ReferenceNumber ?? ""),
            ("Lot number", i => i.LotNumber ?? ""),
            ("Diameter", i => i.DiameterMm.ToString("0.0")),
            ("Length", i => i.LengthMm.ToString("0.0")),
            ("Placed", i => CsvExport.Date(i.PlacementDate)),
            ("Surgeon", i => i.SurgeonStaff?.DisplayName ?? ""),
            ("Torque Ncm", i => i.InsertionTorqueNcm?.ToString() ?? ""),
            ("ISQ", i => i.StabilityQuotientIsq?.ToString() ?? ""),
            ("Bone quality", i => i.BoneQuality.ToString()),
            ("Restored", i => CsvExport.Date(i.RestorationDate)),
            ("Status", i => i.Status.ToString()));

        await CsvExport.DownloadAsync(JS, "implant-registry.csv", csv);
    }
}
