@page "/Account/ForgotPassword"
@layout DentalSurgery.Web.Components.Account.Shared.AuthLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DentalSurgery.Infrastructure.Identity
@using DentalSurgery.Infrastructure.Tenancy
@using DentalSurgery.Application.Abstractions
@using DentalSurgery.Domain.Enums
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject INotificationSender Notifications
@inject TenantContext Tenant
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>
<h2>Enter your email.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            @if (_problem is not null)
            {
                <div class="alert-ds a-warning mb-3" role="alert">
                    <div>@_problem</div>
                </div>
            }

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset password</button>
        </EditForm>
     </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? _problem;

    private async Task OnValidSubmitAsync()
    {
        // Checked before anything is looked up, so the answer depends on the
        // practice's configuration and not on whether the address exists. That
        // keeps the honest "we cannot email you" message from doubling as an
        // account-enumeration oracle.
        if (!Notifications.IsChannelConfigured(CommunicationChannel.Email))
        {
            _problem = "This practice has no email gateway configured, so a reset link cannot be sent. " +
                       "Ask an administrator to set your password directly, or to configure email under " +
                       "Administration → Integrations.";
            return;
        }

        // The account is found across tenants. This request is anonymous, so no
        // tenant is bound and the Users set - filtered like every other table -
        // would otherwise match nothing at all, and every reset would quietly
        // reach the confirmation page having done nothing.
        ApplicationUser? user;
        var normalised = UserManager.NormalizeEmail(Input.Email);

        using (Tenant.EnterPlatformScope("resolving an account for a password reset"))
        {
            var matches = await UserManager.Users
                .Where(u => u.NormalizedEmail == normalised)
                .Take(2)
                .ToListAsync();

            // An address held at two practices cannot be resolved without
            // knowing which one is meant; treated as not found rather than
            // guessing whose password to reset.
            user = matches.Count == 1 ? matches[0] : null;
        }

        // Never reveals whether the account exists or is confirmed.
        if (user is null || !await UserManager.IsEmailConfirmedAsync(user))
        {
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        string callbackUrl;

        // The token is generated inside the account's own tenant, because
        // Identity writes the security stamp while doing it.
        using (Tenant.EnterPlatformScope("issuing a password reset token"))
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });
        }

        try
        {
            await EmailSender.SendPasswordResetLinkAsync(
                user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));
        }
        catch (AccountEmailUnavailableException ex)
        {
            _problem = ex.Message;
            return;
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
