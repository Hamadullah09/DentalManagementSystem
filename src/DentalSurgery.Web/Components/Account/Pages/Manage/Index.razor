@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using DentalSurgery.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Profile - Meridian Dental Surgery</PageTitle>

<StatusMessage />

<div class="card-ds mb-3">
    <div class="card-ds-header">
        <h3>Profile</h3>
    </div>

    <div class="card-ds-body">
        @*
            Who the account is, before what can be edited on it. Most of this is
            set by an administrator and cannot be changed here, and saying so
            plainly is kinder than rendering disabled boxes and letting the
            reader work out why they will not accept anything.
        *@
        <div class="settings-identity">
            <span class="avatar lg">@_initials</span>
            <div>
                <div class="settings-identity-name">@_displayName</div>
                <div class="text-muted" style="font-size:.85rem;">@_email</div>
                @if (_roles.Count > 0)
                {
                    <div class="mt-1">
                        @foreach (var role in _roles)
                        {
                            <span class="badge-ds b-neutral me-1">@Ui.Humanise(role)</span>
                        }
                    </div>
                }
            </div>
        </div>

        <p class="text-muted settings-note">
            Your name, job title and role are set by a practice administrator.
            Ask them if any of it is wrong.
        </p>
    </div>
</div>

<div class="card-ds">
    <div class="card-ds-header">
        <h3>Contact number</h3>
    </div>

    <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />

        <div class="card-ds-body">
            <ValidationSummary class="validation-summary" role="alert" />

            <label class="form-label" for="phone">Phone number</label>
            <InputText @bind-Value="Input.PhoneNumber" id="phone" class="form-control settings-field"
                       autocomplete="tel" placeholder="07700 900000" />
            <ValidationMessage For="() => Input.PhoneNumber" class="field-error" />

            <p class="form-hint">
                Used when a colleague needs to reach you about a patient. It is not
                shown to patients.
            </p>
        </div>

        <div class="card-ds-footer">
            <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
        </div>
    </EditForm>
</div>

@code {
    private ApplicationUser user = default!;
    private string? phoneNumber;

    private string? _email;
    private string? _displayName;
    private string _initials = "?";
    private List<string> _roles = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);

        _email = await UserManager.GetUserNameAsync(user);
        _displayName = user.DisplayName;
        _initials = user.Initials;
        _roles = HttpContext.User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();

        Input.PhoneNumber ??= phoneNumber;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus(
                    "Error: that phone number could not be saved.", HttpContext);
            }
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Your contact number has been saved.", HttpContext);
    }

    private sealed class InputModel
    {
        [Phone(ErrorMessage = "That does not look like a phone number.")]
        [Display(Name = "Phone number")]
        public string? PhoneNumber { get; set; }
    }
}
