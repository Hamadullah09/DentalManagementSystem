@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Personal data</PageTitle>

<StatusMessage />
<h3>Personal data</h3>

<div class="row">
    <div class="col-md-7">
        <p>
            This account holds the personal data you gave the practice when it was
            issued: your name, email address, contact number and job title. You can
            download a copy of it at any time.
        </p>

        @*
            The scaffolded "delete my account" control has been removed rather
            than hidden. A login here is the author of clinical notes,
            prescriptions and financial entries, and deleting it would break the
            attribution those records depend on — and the audit trail is
            append-only by design. Withdrawing someone's access is a
            deactivation, carried out by an administrator, which stops the
            account working while leaving what it signed intact.
        *@
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Download my data</button>
        </form>

        <div class="alert alert-secondary mt-4" role="note">
            <strong>Closing your account.</strong>
            An account cannot be deleted from here. Records you have signed must keep
            naming their author, so access is withdrawn by deactivation instead. Ask a
            practice administrator to deactivate the account when you leave.
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
