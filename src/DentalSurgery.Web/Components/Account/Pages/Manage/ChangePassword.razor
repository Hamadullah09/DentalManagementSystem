@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using DentalSurgery.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Change password</PageTitle>

@if (_forced)
{
    @*
        A first sign-in, or a password an administrator has just reset. The
        account can reach nothing else until this is done, so the page says why
        rather than leaving the user to work it out from a redirect loop.
    *@
    <div class="alert-ds a-warning mb-3" role="alert">
        <Icon Name="key" Size="16" />
        <div>
            <strong>Set your own password before you continue.</strong>
            This account is using a password that someone else chose and knows.
            Nothing else in the system will open until you have replaced it.
        </div>
    </div>
}

<h3>Change password</h3>
<StatusMessage Message="@_message" />

<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="field">
                <label class="field-label" for="old-password">
                    @(_forced ? "The password you were given" : "Current password")
                    <span class="req" aria-hidden="true">*</span>
                </label>
                <div class="password-wrap">
                    <InputText id="old-password" type="password" @bind-Value="Input.OldPassword"
                               class="form-control" autocomplete="current-password" aria-required="true" />
                    <button type="button" class="password-toggle" data-password-toggle="old-password"
                            aria-controls="old-password" aria-pressed="false" aria-label="Show password">
                        <Icon Name="eye" Size="16" />
                    </button>
                </div>
                <ValidationMessage For="() => Input.OldPassword" class="field-error" />
            </div>

            <div class="field">
                <label class="field-label" for="new-password">
                    New password <span class="req" aria-hidden="true">*</span>
                </label>
                <div class="password-wrap">
                    <InputText id="new-password" type="password" @bind-Value="Input.NewPassword"
                               class="form-control" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="password-toggle" data-password-toggle="new-password"
                            aria-controls="new-password" aria-pressed="false" aria-label="Show password">
                        <Icon Name="eye" Size="16" />
                    </button>
                </div>
                <ValidationMessage For="() => Input.NewPassword" class="field-error" />
                <div class="text-muted mt-1" style="font-size:.78rem;">
                    At least 10 characters, including an upper-case letter, a lower-case
                    letter, a digit and a symbol.
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="confirm-password">
                    Confirm new password <span class="req" aria-hidden="true">*</span>
                </label>
                <InputText id="confirm-password" type="password" @bind-Value="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="field-error" />
            </div>

            <button type="submit" class="btn btn-primary auth-submit mt-2" data-busy-label="Saving…">
                <span class="submit-label">Update password</span>
            </button>
        </EditForm>
    </div>
</div>

@code {
    private string? _message;
    private ApplicationUser _user = default!;
    private bool _forced;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _forced = _user.MustChangePassword;

        if (!await UserManager.HasPasswordAsync(_user))
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await UserManager.ChangePasswordAsync(_user, Input.OldPassword, Input.NewPassword);

        if (!result.Succeeded)
        {
            _message = $"Error: {string.Join(" ", result.Errors.Select(e => e.Description))}";
            return;
        }

        // Clears the forced-change flag that MustChangePasswordMiddleware holds
        // the account on. Until this is written back the user would be redirected
        // straight to this page again.
        var wasForced = _user.MustChangePassword;

        if (wasForced)
        {
            _user.MustChangePassword = false;
            await UserManager.UpdateAsync(_user);
        }

        // Re-issues the cookie, which both picks up the cleared flag and
        // invalidates any session still holding the old password's stamp.
        await SignInManager.RefreshSignInAsync(_user);

        Logger.LogInformation("The password for {Email} was changed by its owner.", _user.Email);

        if (wasForced)
        {
            // They came here because they could not go anywhere else. Send them
            // where they were trying to get to, rather than back to this form.
            RedirectManager.RedirectTo("/");
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been changed.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        // Matched to the Identity policy in ConfigureIdentityOptions. The
        // scaffolded value was 6, which let the form accept a password the
        // server then rejected — the user was told their password was too short
        // only after submitting a form that had said it was long enough.
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(128, MinimumLength = 10,
            ErrorMessage = "Use at least 10 characters.")]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
