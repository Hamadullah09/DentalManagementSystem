<NavLink class="nav-link-ds" href="@Href" Match="@(Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
    <span class="icon"><Icon Name="@Icon" Size="17" /></span>
    <span>@Label</span>
    @if (Badge > 0)
    {
        <span class="nav-badge @(BadgeMuted ? "muted" : "")">@(Badge > 99 ? "99+" : Badge.ToString())</span>
    }
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "circle";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Exact { get; set; }
    [Parameter] public int Badge { get; set; }
    [Parameter] public bool BadgeMuted { get; set; }
}
