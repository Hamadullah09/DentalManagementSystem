@implements IDisposable
@inject IDbContextFactory<DentalDbContext> DbFactory
@inject NavigationManager Navigation

<div style="position:relative; max-width:420px; width:100%;">
    <div class="d-flex align-items-center gap-2"
         style="background:var(--ds-surface-2); border:1px solid var(--ds-border); border-radius:8px; padding:.25rem .55rem;">
        <Icon Name="search" Size="15" CssClass="text-muted" />
        <input class="border-0 bg-transparent flex-grow-1"
               style="outline:none; font-size:.86rem; color:var(--ds-text); min-width:0;"
               placeholder="Search patients by name, number or phone"
               value="@_query"
               @oninput="OnInput"
               @onfocus="() => _showResults = true"
               @onkeydown="OnKeyDown" />
        @if (_searching)
        {
            <span class="spinner-border spinner-border-sm text-muted" style="width:13px;height:13px;"></span>
        }
        else if (!string.IsNullOrEmpty(_query))
        {
            <button class="btn-ghost p-0" @onclick="Clear" title="Clear"><Icon Name="x" Size="14" /></button>
        }
    </div>

    @if (_showResults && _results.Count > 0)
    {
        <div class="card-ds"
             style="position:absolute; top:calc(100% + 6px); left:0; right:0; z-index:60; max-height:380px; overflow-y:auto; box-shadow:var(--ds-shadow-lg);">
            @foreach (var (patient, index) in _results.Select((p, i) => (p, i)))
            {
                <button type="button"
                        class="d-flex align-items-center gap-2 w-100 text-start border-0 bg-transparent"
                        style="padding:.5rem .7rem; border-bottom:1px solid var(--ds-border); @(index == _highlighted ? "background:var(--ds-surface-3);" : "")"
                        @onclick="() => Open(patient.Id)">
                    <span class="avatar sm">@patient.DisplayName[..1]</span>
                    <span class="flex-grow-1" style="min-width:0;">
                        <span class="d-block" style="font-weight:600; font-size:.85rem;">@patient.DisplayName</span>
                        <span class="d-block text-muted" style="font-size:.74rem;">
                            @patient.PatientNumber
                            @if (patient.Age.HasValue)
                            {
                                <span>&nbsp;&middot;&nbsp;@patient.Age yrs</span>
                            }
                            @if (!string.IsNullOrEmpty(patient.Phone))
                            {
                                <span>&nbsp;&middot;&nbsp;@patient.Phone</span>
                            }
                        </span>
                    </span>
                    @if (patient.CriticalAlertCount > 0)
                    {
                        <span class="badge-ds b-danger"><Icon Name="alert-triangle" Size="11" /> @patient.CriticalAlertCount</span>
                    }
                    @if (patient.Balance > 0)
                    {
                        <span class="badge-ds b-warning">@Ui.MoneyCompact(patient.Balance)</span>
                    }
                </button>
            }
        </div>
    }
    else if (_showResults && !_searching && _query.Trim().Length >= 2)
    {
        <div class="card-ds text-center text-muted"
             style="position:absolute; top:calc(100% + 6px); left:0; right:0; z-index:60; padding:.9rem; font-size:.85rem;">
            No patient matches &ldquo;@_query&rdquo;
        </div>
    }
</div>

@code {
    private string _query = string.Empty;
    private bool _searching;
    private bool _showResults;
    private int _highlighted;
    private List<PatientListItem> _results = new();
    private CancellationTokenSource? _debounce;

    private async Task OnInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _highlighted = 0;

        // Cancel the previous keystroke's pending search before starting another.
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        if (_query.Trim().Length < 2)
        {
            _results = new List<PatientListItem>();
            _searching = false;
            return;
        }

        _searching = true;

        try
        {
            await Task.Delay(220, token);
            if (token.IsCancellationRequested) return;

            _results = await SearchAsync(_query.Trim(), token);
            _showResults = true;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task<List<PatientListItem>> SearchAsync(string text, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);

        var matches = await db.Patients.AsNoTracking()
            .Where(p =>
                p.PatientNumber.Contains(text) ||
                p.Name.FirstName.Contains(text) ||
                p.Name.LastName.Contains(text) ||
                (p.Contact.MobilePhone != null && p.Contact.MobilePhone.Contains(text)) ||
                (p.Contact.Email != null && p.Contact.Email.Contains(text)))
            .OrderBy(p => p.Name.LastName).ThenBy(p => p.Name.FirstName)
            .Take(8)
            .Select(p => new
            {
                p.Id,
                p.PatientNumber,
                Display = (p.Name.PreferredName ?? p.Name.FirstName) + " " + p.Name.LastName,
                p.DateOfBirth,
                p.Gender,
                Phone = p.Contact.MobilePhone ?? p.Contact.HomePhone,
                Email = p.Contact.Email,
                p.Status,
                p.AccountBalance,
                p.NextRecallDue,
                p.LastExamDate,
                Critical = p.Alerts.Count(a => a.IsActive && a.Severity >= AlertSeverity.High),
                Alerts = p.Alerts.Count(a => a.IsActive)
            })
            .ToListAsync(ct);

        return matches.Select(m => new PatientListItem(
            m.Id, m.PatientNumber, m.Display, m.Display, m.DateOfBirth,
            Age(m.DateOfBirth), m.Gender, m.Phone, m.Email, m.Status,
            m.AccountBalance, m.NextRecallDue, m.LastExamDate, null, m.Alerts, m.Critical))
            .ToList();
    }

    private static int? Age(DateOnly? dob)
    {
        if (dob is null) return null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Value.Year;
        if (today < dob.Value.AddYears(age)) age--;
        return age < 0 ? null : age;
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (_results.Count == 0) return;

        switch (args.Key)
        {
            case "ArrowDown":
                _highlighted = Math.Min(_highlighted + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                _highlighted = Math.Max(_highlighted - 1, 0);
                break;
            case "Enter":
                await Open(_results[_highlighted].Id);
                break;
            case "Escape":
                Clear();
                break;
        }
    }

    private Task Open(Guid patientId)
    {
        Clear();
        Navigation.NavigateTo($"/patients/{patientId}");
        return Task.CompletedTask;
    }

    private void Clear()
    {
        _query = string.Empty;
        _results = new List<PatientListItem>();
        _showResults = false;
        _searching = false;
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
