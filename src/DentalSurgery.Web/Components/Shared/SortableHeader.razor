<th class="@Align" style="cursor:pointer; user-select:none;" @onclick="() => OnSort.InvokeAsync(Field)">
    <span class="d-inline-flex align-items-center gap-1">
        @Label
        @if (IsCurrent)
        {
            <Icon Name="@(Descending ? "arrow-down" : "arrow-up")" Size="11" />
        }
    </span>
</th>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Field { get; set; } = "";
    [Parameter] public string? Current { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public string Align { get; set; } = "";
    [Parameter] public EventCallback<string> OnSort { get; set; }

    private bool IsCurrent => string.Equals(Current, Field, StringComparison.OrdinalIgnoreCase);
}
