<div class="filter-bar">
    <div class="field">
        <label class="form-label">From</label>
        <input type="date" class="form-control form-control-sm"
               value="@From.ToString("yyyy-MM-dd")" @onchange="OnFromChanged" />
    </div>
    <div class="field">
        <label class="form-label">To</label>
        <input type="date" class="form-control form-control-sm"
               value="@To.ToString("yyyy-MM-dd")" @onchange="OnToChanged" />
    </div>
    <div class="field" style="min-width:auto;">
        <label class="form-label">Quick ranges</label>
        <div class="btn-group btn-group-sm">
            @foreach (var preset in Presets)
            {
                <button class="btn btn-outline-secondary" @onclick="() => ApplyPreset(preset.Key)">@preset.Key</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public DateOnly From { get; set; }
    [Parameter] public DateOnly To { get; set; }
    [Parameter] public EventCallback<(DateOnly From, DateOnly To)> OnChanged { get; set; }

    private static readonly Dictionary<string, Func<DateOnly, (DateOnly, DateOnly)>> Presets = new()
    {
        ["Today"] = today => (today, today),
        ["7 days"] = today => (today.AddDays(-6), today),
        ["30 days"] = today => (today.AddDays(-29), today),
        ["This month"] = today => (new DateOnly(today.Year, today.Month, 1), today),
        ["Last month"] = today =>
        {
            var firstOfThis = new DateOnly(today.Year, today.Month, 1);
            var firstOfLast = firstOfThis.AddMonths(-1);
            return (firstOfLast, firstOfThis.AddDays(-1));
        },
        ["Year"] = today => (new DateOnly(today.Year, 1, 1), today)
    };

    private async Task OnFromChanged(ChangeEventArgs args)
    {
        if (!DateOnly.TryParse(args.Value?.ToString(), out var date)) return;
        From = date;
        // Keep the range valid if the user picks a start after the current end.
        if (From > To) To = From;
        await OnChanged.InvokeAsync((From, To));
    }

    private async Task OnToChanged(ChangeEventArgs args)
    {
        if (!DateOnly.TryParse(args.Value?.ToString(), out var date)) return;
        To = date;
        if (To < From) From = To;
        await OnChanged.InvokeAsync((From, To));
    }

    private async Task ApplyPreset(string key)
    {
        var (from, to) = Presets[key](DateOnly.FromDateTime(DateTime.Today));
        From = from;
        To = to;
        await OnChanged.InvokeAsync((From, To));
    }
}
