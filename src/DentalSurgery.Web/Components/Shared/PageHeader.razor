<div class="page-head">
    <div>
        @if (Breadcrumbs is not null && Breadcrumbs.Count > 0)
        {
            <nav class="mb-1" style="font-size:.78rem;">
                @for (var i = 0; i < Breadcrumbs.Count; i++)
                {
                    var crumb = Breadcrumbs[i];
                    if (i > 0)
                    {
                        <span class="text-faint mx-1">/</span>
                    }
                    if (string.IsNullOrEmpty(crumb.Href))
                    {
                        <span class="text-muted">@crumb.Label</span>
                    }
                    else
                    {
                        <a href="@crumb.Href">@crumb.Label</a>
                    }
                }
            </nav>
        }

        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="subtitle">@Subtitle</p>
        }
        @SubtitleContent
    </div>

    @if (Actions is not null)
    {
        <div class="page-head-actions">
            @Actions
        </div>
    }
</div>

@code {
    public record Crumb(string Label, string? Href = null);

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? SubtitleContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public IReadOnlyList<Crumb>? Breadcrumbs { get; set; }
}
