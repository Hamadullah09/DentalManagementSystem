<!DOCTYPE html>
<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="DentalSurgery.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>Meridian Dental Surgery</title>
    <HeadOutlet @rendermode="RenderModeForPage" />
    <script src="theme-init.js"></script>
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />

    <div id="blazor-error-ui">
        Something went wrong. The page needs to be reloaded.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">&#x1F5D9;</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="app.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // The Identity pages are statically rendered; everything else is interactive.
    private IComponentRenderMode? RenderModeForPage => HttpContext.Request.Path.StartsWithSegments("/Account")
        ? null
        : InteractiveServer;
}
