<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host configuration. Publishing rewrites %LAUNCHER_PATH% and %LAUNCHER_ARGS%
  with the real entry point, so this file is the one that ships.

  Everything the deployment needs to *know* - the connection string, the
  administrator's address, the accounts to provision - is injected into
  <environmentVariables> at deploy time from repository secrets. None of it is
  in this file, and none of it is in the repository.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        In-process: the application runs inside the IIS worker rather than
        behind a second HTTP hop, which matters for a Blazor Server app where
        every interaction is a round trip over one long-lived connection.
      -->
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\App_Data\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering removeServerHeader="true">
          <!--
            App_Data holds patient documents and radiographs written by the
            application, and the log files. IIS hides this segment by default;
            saying so here means the protection survives a host that does not.
          -->
          <hiddenSegments>
            <add segment="App_Data" />
          </hiddenSegments>

          <!-- Matches DocumentService.MaxUploadBytes plus multipart overhead. -->
          <requestLimits maxAllowedContentLength="42991616" />
        </requestFiltering>
      </security>

      <!--
        Without this IIS replaces the ASP.NET Core Module's response with its
        own "500 - Internal server error" page, which names nothing. The module
        reports a failure to start as 500.30 or 500.31 and, with
        ASPNETCORE_DETAILEDERRORS set, includes the exception - all of which was
        being discarded before it reached anyone.

        It only passes through a response the application or the module already
        produced. It does not expose anything the application would not have
        sent itself.
      -->
      <httpErrors existingResponse="PassThrough" />

      <httpProtocol>
        <customHeaders>
          <!-- The application sets its own security headers; these only leak version information. -->
          <remove name="X-Powered-By" />
          <remove name="X-AspNet-Version" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
