<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host configuration. Publishing rewrites %LAUNCHER_PATH% and %LAUNCHER_ARGS%
  with the real entry point, and the deployment then overwrites those, along with
  the hosting model and the stdout switch, from repository settings.

  Deliberately minimal.

  An earlier version also set removeServerHeader, hiddenSegments, requestLimits
  and customHeaders. On shared hosting those sections are frequently locked at
  the server level, and a locked section is not ignored - IIS rejects the whole
  file, and every request fails before the application is ever launched. That is
  indistinguishable from the application itself being broken: no process starts,
  so nothing is written to any log, and the only symptom is a 500 with an empty
  body.

  Nothing of substance was lost. The application sets its own security headers in
  UseSecurityHeaders, IIS blocks the App_Data segment by default, and the upload
  cap is enforced in DocumentService. Anything added back here should be added
  one piece at a time, with a deployment in between, because the failure mode
  gives no clue which piece caused it.

  Everything the deployment needs to *know* - the connection string, the accounts
  to provision - is injected into <environmentVariables> at release time from
  repository secrets. None of it is in this file, and none of it is in the
  repository.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\App_Data\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
